{
  "name": "mediflow-server",
  "version": "1.0.0",
  "private": true,
  "description": "MediFlow clinic management REST API",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:local": "node scripts/local-db.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:demo": "node prisma/demo.js",
    "backup": "node scripts/backup.js",
    "test": "vitest run",
    "generate": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "prisma": "^5.22.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}