# MediFlow Environment Configuration

PORT=4000
NODE_ENV=production
CLINIC_NAME="MediFlow Healthcare Group"
TZ_OFFSET_MINUTES=180
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173,http://localhost:4000

# PostgreSQL Connection String (if running external PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mediflow?schema=public

# Session Management
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false

# File Storage & Backups
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# BACKUP_CRON="0 2 * * *" # Daily at 2 AM EAT

# SMTP Email Configuration (Optional - for password resets)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediFlow <no-reply@mediflow.local>"

